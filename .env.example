# ============================================
# StylinSoulMetalArt - Etsy Intelligence App
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Etsy Open API v3 Credentials
# Get these from: https://www.etsy.com/developers/register
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/auth/etsy/callback
ETSY_SHOP_NAME=StylinSoulMetalArt

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stylinsoul

# Token Encryption (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# AI Provider Configuration
# Supports OpenAI-compatible APIs (Qwen, OpenAI, etc.)
AI_PROVIDER=qwen
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=qwen-plus

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SECURITY NOTES:
# - Never expose ETSY_SHARED_SECRET to browser
# - Never expose TOKEN_ENCRYPTION_KEY to browser
# - Never expose AI_API_KEY to browser
# - All Etsy API calls must happen server-side
# - .env.local is in .gitignore
# ============================================
